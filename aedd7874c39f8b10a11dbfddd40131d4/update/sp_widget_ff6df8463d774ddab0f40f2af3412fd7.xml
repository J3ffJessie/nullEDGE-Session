        <template><![CDATA[<div class="panel panel-default">
  <div class="panel-heading">
    <h3 class="panel-title">My Open Requests</h3>
  </div>
  <div class="panel-body">
    <div ng-if="c.data.items.length === 0" class="text-center text-muted">
      <i class="fa fa-inbox fa-2x"></i>
      <p>No open requests found</p>
    </div>
    <table class="table table-striped" ng-if="c.data.items.length > 0">
      <thead>
        <tr>
          <th>Number</th>
          <th>Short Description</th>
          <th>Stage</th>
        </tr>
      </thead>
      <tbody>
        <tr ng-repeat="item in c.data.items track by $index">
          <td>{{item.number}}</td>
          <td>{{item.short_description}}</td>
          <td>{{item.stage}}</td>
        </tr>
      </tbody>
    </table>
  </div>
</div>
]]></template>
