        <template><![CDATA[<div class="panel panel-default">
  <div class="panel-heading">
    <h3 class="panel-title">Scoped Asset Lookup</h3>
  </div>
  <div class="panel-body">
    <div ng-if="c.data.assets.length === 0" class="text-center text-muted">
      <i class="fa fa-inbox fa-2x"></i>
      <p>No assets found</p>
    </div>
    <ul class="list-group" ng-if="c.data.assets.length > 0">
      <li ng-repeat="asset in c.data.assets track by $index" class="list-group-item">
        <strong>{{asset.display_name}}</strong>
        <span class="label label-default pull-right">{{asset.state}}</span>
      </li>
    </ul>
  </div>
</div>
